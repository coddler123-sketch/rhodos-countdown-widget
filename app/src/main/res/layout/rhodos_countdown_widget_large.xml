<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_rhodos_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_background_description"
        android:scaleType="centerCrop"
        android:src="@drawable/rhodos_lindos" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_readability_overlay_4x2"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="14dp"
        android:paddingRight="20dp"
        android:paddingBottom="14dp">

        <!-- Kopfzeile: RHODOS + Herz links, Wetter rechts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_large_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:text="@string/widget_large_title"
                android:textColor="@android:color/white"
                android:textSize="23sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_heart"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginLeft="8dp"
                android:contentDescription="@string/widget_favorite_description"
                android:src="@drawable/ic_heart_outline" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_weather_pill_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:paddingRight="9dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/widget_weather_icon"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_marginRight="5dp"
                    android:contentDescription="@string/widget_weather_description"
                    android:src="@drawable/ic_sun" />

                <TextView
                    android:id="@+id/widget_weather_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="5"
                    android:text="@string/widget_weather_temp"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:text="@string/widget_subtitle"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp" />

        <!-- Countdown: TAGE | STD. | MIN. -->
        <LinearLayout
            android:id="@+id/widget_countdown_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:minWidth="58dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="7"
                    android:text="23"
                    android:textColor="@android:color/white"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:text="@string/widget_days_label"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="1dp"
                android:layout_height="38dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="#40FFFFFF"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:minWidth="58dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="7"
                    android:text="14"
                    android:textColor="@android:color/white"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:text="@string/widget_hours_label"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="1dp"
                android:layout_height="38dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="#40FFFFFF"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:minWidth="58dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_minutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="7"
                    android:text="37"
                    android:textColor="@android:color/white"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:text="@string/widget_minutes_label"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Abflugtag: ersetzt den Countdown, sobald das Ziel erreicht ist -->
        <TextView
            android:id="@+id/widget_arrival_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:includeFontPadding="false"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="7"
            android:text="@string/widget_arrival_message"
            android:textColor="@android:color/white"
            android:textSize="27sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Spruch des Tages -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_date_chip_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="7dp"
            android:paddingRight="15dp"
            android:paddingBottom="7dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginRight="9dp"
                android:contentDescription="@string/widget_phrase_description"
                android:src="@drawable/ic_sparkle" />

            <TextView
                android:id="@+id/widget_phrase_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_phrase"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
